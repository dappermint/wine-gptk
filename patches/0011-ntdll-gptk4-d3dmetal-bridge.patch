+static void *find_macho_symbol( void *base, const char *name )
+{
+    const struct mach_header_64 *header = base;
+    const struct load_command *command;
+    const struct segment_command_64 *text = NULL, *linkedit = NULL;
+    const struct symtab_command *symtab = NULL;
+    const struct nlist_64 *symbols;
+    const char *strings;
+    UINT_PTR slide, linkedit_base;
+    unsigned int i;
+
+    if (header->magic != MH_MAGIC_64) return NULL;
+    command = (const struct load_command *)(header + 1);
+    for (i = 0; i < header->ncmds; i++)
+    {
+        if (command->cmd == LC_SEGMENT_64)
+        {
+            const struct segment_command_64 *segment = (const struct segment_command_64 *)command;
+            if (!strcmp( segment->segname, SEG_TEXT )) text = segment;
+            else if (!strcmp( segment->segname, SEG_LINKEDIT )) linkedit = segment;
+        }
+        else if (command->cmd == LC_SYMTAB) symtab = (const struct symtab_command *)command;
+        command = (const struct load_command *)((const BYTE *)command + command->cmdsize);
+    }
+    if (!text || !linkedit || !symtab) return NULL;
+
+    slide = (UINT_PTR)base - text->vmaddr;
+    linkedit_base = slide + linkedit->vmaddr - linkedit->fileoff;
+    symbols = (const struct nlist_64 *)(linkedit_base + symtab->symoff);
+    strings = (const char *)(linkedit_base + symtab->stroff);
+    for (i = 0; i < symtab->nsyms; i++)
+    {
+        if (!symbols[i].n_un.n_strx) continue;
+        if (!strcmp( strings + symbols[i].n_un.n_strx, name ))
+            return (void *)(slide + symbols[i].n_value);
+    }
+    return NULL;
+}
+
+/* each gptk graphics module carries its own copy of the dispatch init, so the
+ * original has to be remembered per table rather than in one global; a small
+ * bank of wrappers gives each hooked table its own entry point. */
+#define D3DMETAL_MAX_UNIXLIBS 8
+static unixlib_entry_t d3dmetal_orig_init[D3DMETAL_MAX_UNIXLIBS];
+static unixlib_entry_t *d3dmetal_hooked_table[D3DMETAL_MAX_UNIXLIBS];
+static unsigned int d3dmetal_hooked_count;
+
+static NTSTATUS d3dmetal_post_init( void *args, NTSTATUS status, unsigned int slot )
+{
+    void **dispatch = args;
+    unsigned int i;
+
+    if (status) return status;
+
+    if (d3dmetal_enable_unix_call) *d3dmetal_enable_unix_call = TRUE;
+    if (d3dmetal_patch_win32_calls && d3dmetal_win32_dispatch)
+        d3dmetal_patch_win32_calls( d3dmetal_win32_dispatch );
+    if (d3dmetal_patch_entrypoint_calls) d3dmetal_patch_entrypoint_calls();
+    /* PatchUnixCallTable() memmoves 0x60 bytes from a null source into
+       __wine_unix_call_funcs+840 on 4.0b2 and faults.  It carries its own
+       dispatch_once token, so gptk calls it when it is actually ready; calling
+       it from here is what crashes.  Bit 2 of the mask restores the old
+       behaviour for comparison. */
+    {
+        const char *env = getenv( "WINE_D3DM_PATCH_MASK" );
+        unsigned int mask = env ? strtoul( env, NULL, 16 ) : 0;
+
+        if ((mask & 4) && d3dmetal_patch_unix_calls) d3dmetal_patch_unix_calls();
+    }
+
+
+    if (getenv( "WINE_D3DM_KEEP_DISPATCH" )) return status;
+
+    {
+        /* soju-wine keeps {0,9,11,42,43}, derived from gptk 4.0b1 where the
+         * table was sparse.  4.0b2 populates 43 of 44 entries, and bisecting
+         * the keep set on b2 shows exactly one entry cannot be called directly
+         * from PE code: index 1, which faults in pthread_setspecific because
+         * the direct call carries no gsbase swap.  keep the rest and route
+         * that one through the unix call.  overridable for further bisecting. */
+        /* gptk's own D3DRMDispatch_Init clears indices 1-8, 10, 12-41 when
+           enableUnixCall is set, i.e. it keeps {0, 9, 11, 42, 43}.  Its init
+           resets the flag before that test, so the clearing has to be redone
+           here with exactly gptk's list.  Verified against the disassembly of
+           _Z18D3DRMDispatch_InitPv in libd3dshared 4.0b2. */
+        const char *env = getenv( "WINE_D3DM_KEEP_MASK" );
+        unsigned long long keep = 0xc0000000a01ULL;
+
+        if (env) keep = strtoull( env, NULL, 16 );
+        for (i = 0; i < 0x160 / sizeof(*dispatch); i++)
+            if (!(keep & (1ULL << i))) dispatch[i] = NULL;
+    }
+
+    /* entries that must be called directly but whose native code touches
+       pthread state get a gsbase-swapping wrapper instead.  measured on
+       4.0b2: entry 1 (the dxgi factory creators) is the only one that needs
+       it; overridable while that is being re-measured. */
+    {
+        /* off by default: a C wrapper is not safe here, since the compiler may
+           emit %gs-dependent code between the swap and the call.  doing this
+           properly needs a hand-written asm thunk.  kept behind an env var so
+           the measurement can be repeated. */
+        const char *env = getenv( "WINE_D3DM_GS_WRAP_MASK" );
+        unsigned long long wrap = 0;
+
+        if (env) wrap = strtoull( env, NULL, 16 );
+        if (slot < 8)
+        {
+            for (i = 0; i < 0x160 / sizeof(*dispatch); i++)
+            {
+                if (!(wrap & (1ULL << i)) || !dispatch[i]) continue;
+                d3dmetal_direct_call_target[slot] = dispatch[i];
+                dispatch[i] = d3dmetal_gs_thunks[slot];
+                TRACE( "wrapped dispatch entry %u through the gsbase thunk\n", i );
+                break;  /* one wrapped entry per table for now */
+            }
+        }
+    }
+    return status;
+}
+
+#define D3DMETAL_INIT_WRAPPER(n) \
+    static NTSTATUS d3dmetal_dispatch_init_##n( void *args ) \
+    { return d3dmetal_post_init( args, d3dmetal_orig_init[n]( args ), n ); }
+D3DMETAL_INIT_WRAPPER(0)
+D3DMETAL_INIT_WRAPPER(1)
+D3DMETAL_INIT_WRAPPER(2)
+D3DMETAL_INIT_WRAPPER(3)
+D3DMETAL_INIT_WRAPPER(4)
+D3DMETAL_INIT_WRAPPER(5)
+D3DMETAL_INIT_WRAPPER(6)
+D3DMETAL_INIT_WRAPPER(7)
+#undef D3DMETAL_INIT_WRAPPER
+
+static const unixlib_entry_t d3dmetal_init_wrappers[D3DMETAL_MAX_UNIXLIBS] =
+{
+    d3dmetal_dispatch_init_0, d3dmetal_dispatch_init_1,
+    d3dmetal_dispatch_init_2, d3dmetal_dispatch_init_3,
+    d3dmetal_dispatch_init_4, d3dmetal_dispatch_init_5,
+    d3dmetal_dispatch_init_6, d3dmetal_dispatch_init_7,
+};
+
+static void d3dmetal_hook_table( unixlib_entry_t *table )
+{
+    unsigned int i;
+
+    for (i = 0; i < d3dmetal_hooked_count; i++)
+        if (d3dmetal_hooked_table[i] == table) return;
+
+    if (d3dmetal_hooked_count == D3DMETAL_MAX_UNIXLIBS)
+    {
+        ERR( "too many gptk unixlibs to hook\n" );
+        return;
+    }
+    i = d3dmetal_hooked_count++;
+    d3dmetal_hooked_table[i] = table;
+    d3dmetal_orig_init[i] = table[0];
+    table[0] = d3dmetal_init_wrappers[i];
+    TRACE( "hooked gptk dispatch table %p, original init %p\n", table, d3dmetal_orig_init[i] );
+}
+
+/* gptk 4.0b2 dispatches through each graphics module's own unixlib table
+ * (dxgi.so, d3d12.so, ...), not through libd3dshared's, so hooking only the
+ * latter leaves the 0x160-byte dispatch table unsanitised and the first entry
+ * wine 11 does not populate is called as NULL.  every gptk module links
+ * libd3dshared, which wine's own same-named modules never do; that is the
+ * discriminator. */
+void d3dmetal_hook_unixlib( void *so_handle, const void **funcs )
+{
+    unixlib_entry_t *table = (unixlib_entry_t *)*funcs;
+
+    if (!table || !d3dmetal_bridge_active) return;
+    if (!dlsym( so_handle, "_Z18D3DRMDispatch_InitPv" )) return;
+    d3dmetal_hook_table( table );
+}
+
+static void enable_d3dmetal_unix_calls( void *handle )
+{
+    unixlib_entry_t *unix_call_funcs;
+    Dl_info info;
+    void *symbol;
+
+    if (!(symbol = dlsym( handle, "supports_non_native_code_regions" ))) return;
+    if (!dladdr( symbol, &info ) || !info.dli_fbase) return;
+    d3dmetal_enable_unix_call = find_macho_symbol( info.dli_fbase, "__ZL14enableUnixCall" );
+    d3dmetal_win32_dispatch = find_macho_symbol( info.dli_fbase, "__ZL14gWin32Dispatch" );
+    d3dmetal_patch_entrypoint_calls = dlsym( handle, "_Z24PatchEntrypointCallTablev" );
+    d3dmetal_patch_unix_calls = dlsym( handle, "_Z18PatchUnixCallTablev" );
+    d3dmetal_patch_win32_calls = dlsym( handle, "_Z27PatchWin32DispatchFunctionsP13Win32Dispatch" );
+    if (d3dmetal_enable_unix_call) *d3dmetal_enable_unix_call = TRUE;
+
+    d3dmetal_bridge_active = TRUE;
+    if (!(unix_call_funcs = dlsym( handle, "__wine_unix_call_funcs" ))) return;
+    d3dmetal_hook_table( unix_call_funcs );
+    TRACE( "enabled D3DMetal Unix calls\n" );
+}
+
+static void init_non_native_support(void)
+{
+    void *handle;
+    char *path;
+
+    if (asprintf( &path, "%s/../../external/libd3dshared.dylib", ntdll_dir ) == -1) return;
+    handle = dlopen( path, RTLD_NOW | RTLD_GLOBAL );
+    if (!handle)
+    {
+        TRACE( "failed to load %s: %s\n", path, dlerror() );
+        free( path );
+        return;
+    }
+    free( path );
+
+    enable_d3dmetal_unix_calls( handle );
+    supports_non_native_code_regions = dlsym( handle, "supports_non_native_code_regions" );
+    p_register_non_native_code_region = dlsym( handle, "register_non_native_code_region" );
+    if (!supports_non_native_code_regions || !p_register_non_native_code_region ||
+        !supports_non_native_code_regions())
+    {
+        supports_non_native_code_regions = NULL;
+        p_register_non_native_code_region = NULL;
+    }
+}
+
+void register_non_native_code_region( void *base, SIZE_T size )
+{
+    if (p_register_non_native_code_region && base && size)
+        p_register_non_native_code_region( base, size );
+}
+#else
+static void init_non_native_support(void)
+{
+}
+
+void register_non_native_code_region( void *base, SIZE_T size )
+{
+    (void)base;
+    (void)size;
+}
+#endif
