Export __wine_unix_call from ntdll so D3DMetal's PE DLLs can import it.

Ported from CrossOver's CW HACK 22435.  D3DMetal ships PE side DLLs which
import __wine_unix_call by name; upstream only has it as an inline helper
in winternl.h plus the private dispatcher export, so the import fails.

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index d8b7a92bad..ae647e1b51 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -3410,6 +3410,18 @@ NTSTATUS WINAPI __wine_ctrl_routine( void *arg )
 }
 
 
+/***********************************************************************
+ *              __wine_unix_call_exported
+ *
+ * D3DMetal's PE DLLs import __wine_unix_call by name, so it has to be a
+ * real export rather than an inline in winternl.h.
+ */
+NTSTATUS WINAPI __wine_unix_call_exported( unixlib_handle_t handle, unsigned int code, void *args )
+{
+    return __wine_unix_call( handle, code, args );
+}
+
+
 /***********************************************************************
  *           __wine_unix_spawnvp
  */
diff --git a/dlls/ntdll/ntdll.spec b/dlls/ntdll/ntdll.spec
index 0b6d9b2cbf..d0912cce72 100644
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -1765,6 +1765,7 @@
 @ stdcall __wine_unix_spawnvp(long ptr)
 @ stdcall __wine_ctrl_routine(ptr)
 @ extern -private __wine_syscall_dispatcher
+@ stdcall __wine_unix_call(int64 long ptr) __wine_unix_call_exported
 @ extern -private __wine_unix_call_dispatcher
 @ extern -private -arch=arm64ec __wine_unix_call_dispatcher_arm64ec
 @ extern -private __wine_unixlib_handle
