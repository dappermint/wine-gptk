winemac: Export the macdrv_functions table D3DMetal binds to.

Ported from rishiad/soju-wine 0002-gptk-4-mac-driver-abi.patch, which applied
to wine 11.14 unchanged.  D3DMetal looks up macdrv_functions by name and
expects a wine-7 era macdrv_win_data view; the modern client_view sits behind
the compat shim.
diff --git a/dlls/winemac.drv/macdrv_main.c b/dlls/winemac.drv/macdrv_main.c
index 19ee345..434807a 100644
--- a/dlls/winemac.drv/macdrv_main.c
+++ b/dlls/winemac.drv/macdrv_main.c
@@ -652,3 +652,81 @@ const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
 C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
 
 #endif /* _WIN64 */
+#include <stdlib.h>
+/*
+ * Compatibility bridge for Apple's D3DMetal Unix library.
+ *
+ * D3DMetal expects the leading Wine 7 macdrv_win_data layout.  Keep the
+ * modern driver layout private and expose a short-lived compatibility view.
+ */
+struct d3dmetal_win_data
+{
+    HWND hwnd;
+    macdrv_window cocoa_window;
+    macdrv_view cocoa_view;
+    macdrv_view client_cocoa_view;
+    struct macdrv_win_data *data;
+};
+
+static void d3dmetal_init_display_devices(BOOL force)
+{
+    /* Modern Wine initializes displays through pUpdateDisplayDevices. */
+}
+
+static struct d3dmetal_win_data *d3dmetal_get_win_data(HWND hwnd)
+{
+    struct macdrv_win_data *data;
+    struct d3dmetal_win_data *compat;
+
+    if (!(data = get_win_data(hwnd))) return NULL;
+    if (!(compat = malloc(sizeof(*compat))))
+    {
+        release_win_data(data);
+        return NULL;
+    }
+
+    compat->hwnd = data->hwnd;
+    compat->cocoa_window = data->cocoa_window;
+    compat->cocoa_view = data->client_view;
+    compat->client_cocoa_view = data->client_view;
+    compat->data = data;
+    return compat;
+}
+
+static void d3dmetal_release_win_data(struct d3dmetal_win_data *compat)
+{
+    release_win_data(compat->data);
+    free(compat);
+}
+
+void OnMainThread(dispatch_block_t block);
+
+struct d3dmetal_macdrv_functions
+{
+    void (*init_display_devices)(BOOL force);
+    struct d3dmetal_win_data *(*get_win_data)(HWND hwnd);
+    void (*release_win_data)(struct d3dmetal_win_data *data);
+    macdrv_window (*get_cocoa_window)(HWND hwnd, BOOL require_on_screen);
+    macdrv_metal_device (*create_metal_device)(void);
+    void (*release_metal_device)(macdrv_metal_device device);
+    macdrv_metal_view (*create_metal_view)(macdrv_view view, macdrv_metal_device device);
+    macdrv_metal_layer (*get_metal_layer)(macdrv_metal_view view);
+    void (*release_metal_view)(macdrv_metal_view view);
+    void (*on_main_thread)(dispatch_block_t block);
+};
+
+__attribute__((visibility("default")))
+struct d3dmetal_macdrv_functions macdrv_functions =
+{
+    d3dmetal_init_display_devices,
+    d3dmetal_get_win_data,
+    d3dmetal_release_win_data,
+    macdrv_get_cocoa_window,
+    macdrv_create_metal_device,
+    macdrv_release_metal_device,
+    macdrv_view_create_metal_view,
+    macdrv_view_get_metal_layer,
+    macdrv_view_release_metal_view,
+    OnMainThread,
+};
+
