WIP: msync: back wine 11's shared sync objects with an shm index.

Diagnosis, not yet a validated fix.  With 0004 + 0007, WINEMSYNC=1 hangs
before any application code runs: `wine cmd /c echo HELLO` never prints.
Tracing (WINEDEBUG=+msync) shows three threads parked forever:

  STUCK 0024: waiting on 0x4 0x14    timeout 300s   \KernelObjects\__wineboot_event
  STUCK 002c: waiting on 0x38 0x3c   INFINITE       __wine_SvcctlStarted
  STUCK 003c: waiting on 0xac        INFINITE

and a client stack in msync_wait_multiple() while the wineserver main loop is
healthy.  So the client waits on shm indices the server never signals.

Cause: 0004 is a wine 10 era design where each waitable server type carries
its own msync_idx.  wine 11 moved the signaled state of nearly every type out
into a shared sync object reached through object_ops::get_sync -- 20 server
files delegate to it -- and 0004's server half only implements get_msync_idx
on its own msync_ops objects.  Every server-created event therefore reports no
msync index, the client parks on a slot nothing ever sets, and startup
deadlocks on the very first internal event.

This does two things:

  - gives event_sync (the type behind create_event_sync/create_internal_sync,
    which is what \KernelObjects\__wineboot_event and friends actually are) an
    shm index that mirrors its signaled bit: allocated at create, signalled in
    event_sync_signal, cleared on auto-reset consumption in
    event_sync_satisfied, freed in destroy.
  - resolves get_msync_idx through get_sync in the server's get_msync_idx
    handler, so every type whose sync is an event_sync becomes msync-capable
    without a per-type hook.

Untested: it has not been built into a complete runtime yet, because a
wineserver built from a differently configured tree is ABI-incompatible with
the artifact's ntdll and hangs silently when hot-swapped.  Mutex, semaphore,
timer, queue, process and thread still need the same treatment before msync
can be considered working; do not enable WINEMSYNC by default on this basis.

diff --git a/server/event.c b/server/event.c
index 150ec13..82e4872 100644
--- a/server/event.c
+++ b/server/event.c
@@ -34,6 +34,7 @@
 #include "thread.h"
 #include "request.h"
 #include "security.h"
+#include "msync.h"
 
 static const WCHAR event_name[] = {'E','v','e','n','t'};
 
@@ -54,12 +55,15 @@ struct event_sync
     struct object  obj;             /* object header */
     unsigned int   manual : 1;      /* is it a manual reset event? */
     unsigned int   signaled : 1;    /* event has been signaled */
+    unsigned int   msync_idx;       /* msync shm index mirroring signaled */
 };
 
 static void event_sync_dump( struct object *obj, int verbose );
 static int event_sync_signaled( struct object *obj, struct wait_queue_entry *entry );
 static void event_sync_satisfied( struct object *obj, struct wait_queue_entry *entry );
 static int event_sync_signal( struct object *obj, unsigned int access, int signal );
+static unsigned int event_sync_get_msync_idx( struct object *obj, enum msync_type *type );
+static void event_sync_destroy( struct object *obj );
 
 static const struct object_ops event_sync_ops =
 {
@@ -71,6 +75,8 @@ static const struct object_ops event_sync_ops =
     .signaled     = event_sync_signaled,
     .satisfied    = event_sync_satisfied,
     .signal       = event_sync_signal,
+    .get_msync_idx = event_sync_get_msync_idx,
+    .destroy      = event_sync_destroy,
 };
 
 static struct object *create_event_sync( int manual, int signaled )
@@ -82,6 +88,8 @@ static struct object *create_event_sync( int manual, int signaled )
     if (!(event = alloc_object( &event_sync_ops ))) return NULL;
     event->manual   = manual;
     event->signaled = signaled;
+    event->msync_idx = 0;
+    if (do_msync()) event->msync_idx = msync_alloc_shm( signaled, 0 );
 
     return &event->obj;
 }
@@ -93,6 +101,8 @@ struct event_sync *create_server_internal_sync( int manual, int signaled )
     if (!(event = alloc_object( &event_sync_ops ))) return NULL;
     event->manual   = manual;
     event->signaled = signaled;
+    event->msync_idx = 0;
+    if (do_msync()) event->msync_idx = msync_alloc_shm( signaled, 0 );
 
     return event;
 }
@@ -123,7 +133,11 @@ static void event_sync_satisfied( struct object *obj, struct wait_queue_entry *e
     struct event_sync *event = (struct event_sync *)obj;
     assert( obj->ops == &event_sync_ops );
     /* Reset if it's an auto-reset event */
-    if (!event->manual) event->signaled = 0;
+    if (!event->manual)
+    {
+        event->signaled = 0;
+        if (do_msync() && event->msync_idx) msync_clear_shm( event->msync_idx );
+    }
 }
 
 static int event_sync_signal( struct object *obj, unsigned int access, int signal )
@@ -131,11 +145,33 @@ static int event_sync_signal( struct object *obj, unsigned int access, int signa
     struct event_sync *event = (struct event_sync *)obj;
     assert( obj->ops == &event_sync_ops );
 
-    /* wake up all waiters if manual reset, a single one otherwise */
-    if ((event->signaled = !!signal)) wake_up( &event->obj, !event->manual );
+    /* wake up all waiters if manual reset, a single one otherwise; the shm
+     * mirror must move first so an msync waiter polling it wakes without a
+     * server round trip */
+    if ((event->signaled = !!signal))
+    {
+        if (do_msync() && event->msync_idx) msync_signal_all( event->msync_idx );
+        wake_up( &event->obj, !event->manual );
+    }
+    else if (do_msync() && event->msync_idx) msync_clear_shm( event->msync_idx );
     return 1;
 }
 
+static unsigned int event_sync_get_msync_idx( struct object *obj, enum msync_type *type )
+{
+    struct event_sync *event = (struct event_sync *)obj;
+    assert( obj->ops == &event_sync_ops );
+    *type = event->manual ? MSYNC_MANUAL_SERVER : MSYNC_AUTO_SERVER;
+    return event->msync_idx;
+}
+
+static void event_sync_destroy( struct object *obj )
+{
+    struct event_sync *event = (struct event_sync *)obj;
+    assert( obj->ops == &event_sync_ops );
+    if (do_msync() && event->msync_idx) msync_destroy_semaphore( event->msync_idx );
+}
+
 struct event
 {
     struct object      obj;             /* object header */
