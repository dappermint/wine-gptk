+void *p__wine_native_thread_start = NULL;
 SYSTEM_DLL_INIT_BLOCK *pLdrSystemDllInitBlock = NULL;
 
 #ifdef __GNUC__
@@ -126,6 +129,145 @@ const char **dll_paths = NULL;
 const char **system_dll_paths = NULL;
 const char *user_name = NULL;
 SECTION_IMAGE_INFORMATION main_image_info = { NULL };
+static void *main_image_base;
+static SIZE_T main_image_size;
+
+#if defined(__APPLE__) && defined(__x86_64__)
+static BOOL (*supports_non_native_code_regions)(void);
+static void (*p_register_non_native_code_region)(void *, SIZE_T);
+static BYTE *d3dmetal_enable_unix_call;
+static void *d3dmetal_win32_dispatch;
+static void (*d3dmetal_patch_entrypoint_calls)(void);
+static void (*d3dmetal_patch_unix_calls)(void);
+static void (*d3dmetal_patch_win32_calls)(void *);
+static unixlib_entry_t d3dmetal_dispatch_init;
+
+static void *find_macho_symbol( void *base, const char *name )
+{
+    const struct mach_header_64 *header = base;
+    const struct load_command *command;
+    const struct segment_command_64 *text = NULL, *linkedit = NULL;
+    const struct symtab_command *symtab = NULL;
+    const struct nlist_64 *symbols;
+    const char *strings;
+    UINT_PTR slide, linkedit_base;
+    unsigned int i;
+
+    if (header->magic != MH_MAGIC_64) return NULL;
+    command = (const struct load_command *)(header + 1);
+    for (i = 0; i < header->ncmds; i++)
+    {
+        if (command->cmd == LC_SEGMENT_64)
+        {
+            const struct segment_command_64 *segment = (const struct segment_command_64 *)command;
+            if (!strcmp( segment->segname, SEG_TEXT )) text = segment;
+            else if (!strcmp( segment->segname, SEG_LINKEDIT )) linkedit = segment;
+        }
+        else if (command->cmd == LC_SYMTAB) symtab = (const struct symtab_command *)command;
+        command = (const struct load_command *)((const BYTE *)command + command->cmdsize);
+    }
+    if (!text || !linkedit || !symtab) return NULL;
+
+    slide = (UINT_PTR)base - text->vmaddr;
+    linkedit_base = slide + linkedit->vmaddr - linkedit->fileoff;
+    symbols = (const struct nlist_64 *)(linkedit_base + symtab->symoff);
+    strings = (const char *)(linkedit_base + symtab->stroff);
+    for (i = 0; i < symtab->nsyms; i++)
+    {
+        if (!symbols[i].n_un.n_strx) continue;
+        if (!strcmp( strings + symbols[i].n_un.n_strx, name ))
+            return (void *)(slide + symbols[i].n_value);
+    }
+    return NULL;
+}
+
+static NTSTATUS d3dmetal_dispatch_init_compat( void *args )
+{
+    void **dispatch = args;
+    NTSTATUS status;
+    unsigned int i;
+
+    status = d3dmetal_dispatch_init( args );
+    if (status) return status;
+
+    if (d3dmetal_enable_unix_call) *d3dmetal_enable_unix_call = TRUE;
+    if (d3dmetal_patch_win32_calls && d3dmetal_win32_dispatch)
+        d3dmetal_patch_win32_calls( d3dmetal_win32_dispatch );
+    if (d3dmetal_patch_entrypoint_calls) d3dmetal_patch_entrypoint_calls();
+    if (d3dmetal_patch_unix_calls) d3dmetal_patch_unix_calls();
+
+    for (i = 0; i < 0x160 / sizeof(*dispatch); i++)
+    {
+        if (i == 0 || i == 0x48 / 8 || i == 0x58 / 8 || i == 0x150 / 8 || i == 0x158 / 8)
+            continue;
+        dispatch[i] = NULL;
+    }
+    return status;
+}
+
+static void enable_d3dmetal_unix_calls( void *handle )
+{
+    unixlib_entry_t *unix_call_funcs;
+    Dl_info info;
+    void *symbol;
+
+    if (!(symbol = dlsym( handle, "supports_non_native_code_regions" ))) return;
+    if (!dladdr( symbol, &info ) || !info.dli_fbase) return;
+    d3dmetal_enable_unix_call = find_macho_symbol( info.dli_fbase, "__ZL14enableUnixCall" );
+    d3dmetal_win32_dispatch = find_macho_symbol( info.dli_fbase, "__ZL14gWin32Dispatch" );
+    d3dmetal_patch_entrypoint_calls = dlsym( handle, "_Z24PatchEntrypointCallTablev" );
+    d3dmetal_patch_unix_calls = dlsym( handle, "_Z18PatchUnixCallTablev" );
+    d3dmetal_patch_win32_calls = dlsym( handle, "_Z27PatchWin32DispatchFunctionsP13Win32Dispatch" );
+    if (d3dmetal_enable_unix_call) *d3dmetal_enable_unix_call = TRUE;
+
+    if (!(unix_call_funcs = dlsym( handle, "__wine_unix_call_funcs" ))) return;
+    d3dmetal_dispatch_init = unix_call_funcs[0];
+    unix_call_funcs[0] = d3dmetal_dispatch_init_compat;
+    TRACE( "enabled D3DMetal Unix calls\n" );
+}
+
+static void init_non_native_support(void)
+{
+    void *handle;
+    char *path;
+
+    if (asprintf( &path, "%s/../../external/libd3dshared.dylib", ntdll_dir ) == -1) return;
+    handle = dlopen( path, RTLD_NOW | RTLD_GLOBAL );
+    if (!handle)
+    {
+        TRACE( "failed to load %s: %s\n", path, dlerror() );
+        free( path );
+        return;
+    }
+    free( path );
+
+    enable_d3dmetal_unix_calls( handle );
+    supports_non_native_code_regions = dlsym( handle, "supports_non_native_code_regions" );
+    p_register_non_native_code_region = dlsym( handle, "register_non_native_code_region" );
+    if (!supports_non_native_code_regions || !p_register_non_native_code_region ||
+        !supports_non_native_code_regions())
+    {
+        supports_non_native_code_regions = NULL;
+        p_register_non_native_code_region = NULL;
+    }
+}
+
+void register_non_native_code_region( void *base, SIZE_T size )
+{
+    if (p_register_non_native_code_region && base && size)
+        p_register_non_native_code_region( base, size );
+}
+#else
+static void init_non_native_support(void)
+{
+}
+
+void register_non_native_code_region( void *base, SIZE_T size )
+{
+    (void)base;
+    (void)size;
+}
+#endif
 
