         if (status == STATUS_IMAGE_MACHINE_TYPE_MISMATCH && info->ComPlusNativeReady)
         {
             info->Machine = native_machine;
@@ -1566,6 +1716,7 @@ static void load_ntdll_functions( HMODULE module )
     if (!(p##name = (void *)find_named_export( module, exports, #name ))) \
         ERR( "%s not found\n", #name )
 
+    GET_FUNC( __wine_native_thread_start );
     GET_FUNC( DbgUiRemoteBreakin );
     GET_FUNC( KiRaiseUserExceptionDispatcher );
     GET_FUNC( KiUserExceptionDispatcher );
@@ -1859,6 +2010,8 @@ static void start_main_thread(void)
     dbg_init();
     startup_info_size = server_init_process();
     msync_init();
+    init_non_native_support();
+    register_non_native_code_region( main_image_base, main_image_size );
     virtual_map_user_shared_data();
     init_cpu_info();
     init_files();
