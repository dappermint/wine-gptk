 extern void *p__wine_ctrl_routine;
+extern void *p__wine_native_thread_start;
 extern SYSTEM_DLL_INIT_BLOCK *pLdrSystemDllInitBlock;
 
 struct _FILE_FS_DEVICE_INFORMATION;
+extern NTSTATUS run_native_thread(void *args);
+extern void register_non_native_code_region(void *base, SIZE_T size);
 
 extern const char wine_build[];
 
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index db820a8..3143b98 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -3846,6 +3846,7 @@ NTSTATUS virtual_map_builtin_module( HANDLE mapping, void **module, SIZE_T *size
 NTSTATUS virtual_map_module( HANDLE mapping, void **module, SIZE_T *size, SECTION_IMAGE_INFORMATION *info,
                              ULONG_PTR limit_low, ULONG_PTR limit_high, USHORT machine )
 {
+    BOOL native = FALSE;
     unsigned int status;
     mem_size_t full_size;
     unsigned int sec_flags;
@@ -3866,8 +3867,12 @@ NTSTATUS virtual_map_module( HANDLE mapping, void **module, SIZE_T *size, SECTIO
         status = virtual_map_image( mapping, module, size, limit_low, limit_high, 0,
                                     pe_mapping, machine, FALSE, 0 );
         virtual_fill_image_information( &pe_mapping->image, info );
+        /* a real PE image rather than a builtin: rosetta must know about it
+           before d3dmetal's native code calls in */
+        native = TRUE;
     }
     free_pe_mapping_info( pe_mapping );
+    if (native && NT_SUCCESS(status)) register_non_native_code_region( *module, *size );
     return status;
 }
 
