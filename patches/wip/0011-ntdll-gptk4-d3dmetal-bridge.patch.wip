index 546963a..02ebd46 100644
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -32,6 +32,7 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <dlfcn.h>
 #include <pthread.h>
 #include <signal.h>
 #include <sys/types.h>
@@ -74,6 +75,7 @@
 #include "ddk/wdm.h"
 #include "wine/server.h"
 #include "wine/debug.h"
+#include "unixlib.h"
 #include "unix_private.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(thread);
@@ -1242,6 +1244,61 @@ NTSTATUS init_thread_stack( TEB *teb, ULONG_PTR limit, SIZE_T reserve_size, SIZE
 }
 
 
+#ifdef __APPLE__
+static BOOL is_d3dmetal_native_address( void *address )
+{
+    Dl_info info;
+    const char *name;
+
+    if (!dladdr( address, &info ) || !info.dli_fname) return FALSE;
+    name = strrchr( info.dli_fname, '/' );
+    name = name ? name + 1 : info.dli_fname;
+    return !strcmp( name, "libd3dshared.dylib" ) || !strcmp( name, "D3DMetal" );
+}
+
+static void *get_native_d3dmetal_thread( PRTL_THREAD_START_ROUTINE start )
+{
+    static const BYTE thunk_prefix[] =
+    {
+        0x48, 0x83, 0xec, 0x28, /* sub $0x28,%rsp */
+        0x49, 0x89, 0xc8,       /* mov %rcx,%r8 */
+        0x48, 0x8b, 0x05,       /* mov disp32(%rip),%rax */
+    };
+    BYTE code[14];
+    LONG displacement;
+    void **slot;
+    void *target;
+
+    if (virtual_uninterrupted_read_memory( (void *)start, code, sizeof(code) ) != sizeof(code)) return NULL;
+    if (memcmp( code, thunk_prefix, sizeof(thunk_prefix) )) return NULL;
+
+    memcpy( &displacement, code + sizeof(thunk_prefix), sizeof(displacement) );
+    slot = (void **)((BYTE *)start + sizeof(code) + displacement);
+    if (virtual_uninterrupted_read_memory( slot, &target, sizeof(target) ) != sizeof(target)) return NULL;
+    return is_d3dmetal_native_address( target ) ? target : NULL;
+}
+#else
+static void *get_native_d3dmetal_thread( PRTL_THREAD_START_ROUTINE start )
+{
+    (void)start;
+    return NULL;
+}
+#endif
+
+
+NTSTATUS run_native_thread( void *args )
+{
+    typedef ULONG (__attribute__((ms_abi)) *native_thread_proc)(void *);
+    struct native_thread_params *params = args;
+    struct thread_data *thread_data = get_thread_data();
+    native_thread_proc start = (void *)thread_data->native_start;
+
+    if (!start) return STATUS_INVALID_PARAMETER;
+    params->result = start( thread_data->native_param );
+    return STATUS_SUCCESS;
+}
+
+
 /***********************************************************************
  *           create_server_thread
  */
@@ -1298,8 +1355,28 @@ static NTSTATUS create_server_thread( HANDLE *handle, struct thread_data **data_
 
     data->request_fd = request_pipe[1];
     data->tid        = tid;
-    data->start      = start;
-    data->param      = param;
+
+    /* D3DMetal worker threads have native entry points that cannot run on a
+     * wine thread; route them through __wine_native_thread_start.  wine 11
+     * moved this assignment here from NtCreateThreadEx, which also covers
+     * PsCreateSystemThread since it shares this helper. */
+    {
+        void *native_start = get_native_d3dmetal_thread( start );
+
+        if (p__wine_native_thread_start && native_start)
+        {
+            TRACE( "bridging native D3DMetal thread entry %p through %p\n", start, native_start );
+            data->native_start = native_start;
+            data->native_param = param;
+            data->start        = (void *)p__wine_native_thread_start;
+            data->param        = NULL;
+        }
+        else
+        {
+            data->start = start;
+            data->param = param;
+        }
+    }
 
     *data_ret = data;
     return STATUS_SUCCESS;
