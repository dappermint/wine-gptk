 # include <mach/mach_error.h>
 # include <mach-o/getsect.h>
 # include <crt_externs.h>
@@ -105,6 +107,7 @@ void *pKiUserEmulationDispatcher = NULL;
 void *pLdrInitializeThunk = NULL;
 void *pRtlUserThreadStart = NULL;
