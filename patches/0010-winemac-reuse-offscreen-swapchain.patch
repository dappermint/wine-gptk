winemac: Reuse one offscreen swapchain per top level across surface rebuilds.

A resizing client does not resize its swapchain in place: it destroys the whole
client surface and builds a new one.  Each cycle publishes a new CAContext with
a new id, and the hosting window drops its CALayerHost for the old id before
the new context has presented, so there is an interval with nothing on screen.
That interval is the resize flash.  Measured on steam's client with
WINEDEBUG=trace+macdrv, one resize step gives two client_surface_destroy calls
and RELEASE(old) before CREATE(new).

Holding the outgoing context alive narrows the interval but cannot close it,
because the hosting side has already dropped the host that mirrors it; holding
the host instead is worse, since a host whose context has gone renders black.
Both were tried.  The interval only disappears if the context id stops
changing, so keep the swapchain instead of rebuilding it: one offscreen chain
per top level, handed back when the surface is rebuilt, with the new geometry
pushed into the existing layer tree the way macdrv_client_surface_update()
already does.  No RELEASE/CREATE pair is sent and the hosting side has nothing
to tear down.

Eviction cannot hang off macdrv_DestroyWindow(): the swapchain lives in the
rendering process, where the top level belongs to another process and that
entry point never runs for it.  The cache is swept on use instead, so a chain
whose window has gone is released at the next acquire or destroy.

diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index d35c5c3..213f31b 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -1070,13 +1070,93 @@ static void perform_window_command(HWND hwnd, unsigned int style_any, unsigned i
     NtUserPostMessage(hwnd, WM_SYSCOMMAND, command, 0);
 }
 
+/* A resizing client does not resize its swapchain: it destroys the whole client
+ * surface and builds a new one.  Every such cycle republishes a new CAContext
+ * with a new id, and the hosting window drops its CALayerHost for the old id
+ * before the new one has presented -- so there is a window in which nothing is
+ * on screen at all, which is the resize flash.
+ *
+ * Holding the old context, or the old host, only narrows that window; the fix
+ * is to not open it.  Keep one offscreen swapchain per top level and hand the
+ * same one back when the surface is rebuilt, so the context id never changes
+ * across a resize, no RELEASE/CREATE pair is ever sent, and the hosting side
+ * has nothing to tear down.  The new geometry is pushed into the existing
+ * layer tree by macdrv_client_surface_update() as it already is.
+ *
+ * The swapchain lives in the RENDERING process, where the top level belongs to
+ * another process and macdrv_DestroyWindow() never runs for it, so entries
+ * cannot be evicted there.  Sweep on use instead: a cached chain whose window
+ * has gone is released the next time any surface is acquired or destroyed. */
+struct cached_swapchain
+{
+    struct list             entry;
+    HWND                    toplevel;
+    macdrv_metal_swapchain  swapchain;
+};
+
+static struct list cached_swapchains = LIST_INIT( cached_swapchains );
+
+static void sweep_cached_swapchains(void)
+{
+    struct cached_swapchain *cached, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( cached, next, &cached_swapchains, struct cached_swapchain, entry )
+    {
+        if (NtUserIsWindow( cached->toplevel )) continue;
+        TRACE("evicting cached swapchain for dead window %p\n", cached->toplevel);
+        list_remove( &cached->entry );
+        macdrv_destroy_swapchain( cached->swapchain );
+        free( cached );
+    }
+}
+
+static macdrv_metal_swapchain take_cached_swapchain( HWND toplevel )
+{
+    struct cached_swapchain *cached;
+
+    LIST_FOR_EACH_ENTRY( cached, &cached_swapchains, struct cached_swapchain, entry )
+    {
+        if (cached->toplevel != toplevel) continue;
+        {
+            macdrv_metal_swapchain swapchain = cached->swapchain;
+            list_remove( &cached->entry );
+            free( cached );
+            return swapchain;
+        }
+    }
+    return NULL;
+}
+
+static void put_cached_swapchain( HWND toplevel, macdrv_metal_swapchain swapchain )
+{
+    struct cached_swapchain *cached;
+
+    if (!(cached = malloc( sizeof(*cached) )))
+    {
+        macdrv_destroy_swapchain( swapchain );
+        return;
+    }
+    cached->toplevel = toplevel;
+    cached->swapchain = swapchain;
+    list_add_tail( &cached_swapchains, &cached->entry );
+}
+
 static void macdrv_client_surface_destroy(struct client_surface *client)
 {
     struct macdrv_client_surface *surface = impl_from_client_surface(client);
 
     TRACE("%s\n", debugstr_client_surface(client));
 
-    if (surface->metal_swapchain) macdrv_destroy_swapchain(surface->metal_swapchain);
+    sweep_cached_swapchains();
+
+    if (!surface->metal_swapchain) return;
+
+    /* only the offscreen kind is worth keeping: a view swapchain belongs to a
+     * cocoa view that is going away with the surface */
+    if (surface->toplevel && NtUserIsWindow( surface->toplevel ))
+        put_cached_swapchain( surface->toplevel, surface->metal_swapchain );
+    else
+        macdrv_destroy_swapchain( surface->metal_swapchain );
 }
 
 static void macdrv_client_surface_detach(struct client_surface *client)
@@ -1229,10 +1309,21 @@ BOOL macdrv_client_surface_acquire_metal_swapchain(struct macdrv_client_surface
             return FALSE;
         }
 
+        sweep_cached_swapchains();
+
         surface->toplevel = toplevel;
         surface->hosted_container = container;
         surface->hosted_frame = frame;
-        surface->metal_swapchain = macdrv_create_offscreen_swapchain(toplevel,
+
+        if ((surface->metal_swapchain = take_cached_swapchain( toplevel )))
+        {
+            /* same context id as before, so the hosting window keeps the
+             * CALayerHost it already has and never blanks */
+            TRACE("reusing cached swapchain for %p\n", toplevel);
+            macdrv_swapchain_set_frame(surface->metal_swapchain,
+                    cgrect_from_rect(container), cgrect_from_rect(frame));
+        }
+        else surface->metal_swapchain = macdrv_create_offscreen_swapchain(toplevel,
                 cgrect_from_rect(container), cgrect_from_rect(frame));
     }
 
