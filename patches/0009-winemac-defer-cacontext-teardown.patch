winemac: Keep the outgoing CAContext alive until this window makes its next one.

A CALayerHost owns no pixels: it mirrors a remote CAContext.  The hosting
window therefore has nothing to show the instant the rendering process tears
its context down, and a client that resizes does not resize in place -- it
destroys the whole client surface and builds a new one -- so that teardown
lands in the middle of every resize step.  Measured on steam's client with
WINEDEBUG=trace+macdrv, one resize step produces two client_surface_destroy
calls and RELEASE(old) before CREATE(new).  The result is one black frame per
step, which an interactive drag turns into visible strobing.

Hold the outgoing context, its metal layer and the container back, and release
them when this window's next swapchain is torn down, by which point a successor
has long since published.

Keyed by hwnd, not a single global slot: a window can host more than one
cross-process surface at a time -- steam's store page has a separate renderer
surface from the client chrome, its library does not -- and with one slot only
whichever context was released last is covered, so the store page kept flashing
while the library stopped.

Only the publisher's half of the pair is held.  An earlier version of this also
retained the hosting side's CALayerHost, on the theory that keeping it in the
tree preserved the last frame; it does not, for the reason in the first
paragraph, and once its context was released that host became a permanently
black layer in the window -- the store page flashed and then stayed black.

diff --git a/dlls/winemac.drv/cocoa_window.m b/dlls/winemac.drv/cocoa_window.m
index 1de9f0a..55a18c6 100644
--- a/dlls/winemac.drv/cocoa_window.m
+++ b/dlls/winemac.drv/cocoa_window.m
@@ -4089,6 +4089,11 @@ @interface CAContextSwapChain : NSObject <WineMetalSwapChain>
 
 - (instancetype) initWithHwnd:(void*)hwnd container:(CGRect)container frame:(CGRect)frame;
 - (void) setContainer:(CGRect)container frame:(CGRect)frame;
++ (void) deferTeardownForHwnd:(void *)owner
+                     context:(CAContext *)context
+                       layer:(CAMetalLayer *)layer
+                   container:(CALayer *)container
+                      device:(macdrv_metal_device)dev;
 
 @end
 
@@ -4172,14 +4177,19 @@ - (CAMetalLayer*) layer
     return offscreen_layer;
 }
 
-- (void) dealloc
-{
-    if (context_id) macdrv_release_remote_layer(hwnd, context_id);
-    CAContext *context = remote_context;
-    CAMetalLayer *layer = offscreen_layer;
-    CALayer *container = container_layer;
-    macdrv_metal_device dev = device;
+/* A CALayerHost owns no pixels: it mirrors a remote CAContext.  The hosting
+   window therefore goes blank the instant this process tears its context down,
+   and a resizing client destroys its whole surface and builds a new one, so
+   that teardown lands mid-resize -- one black frame per step.
 
+   Keep the outgoing context, and the layers it publishes, alive until this
+   window creates its next one.  Keyed by hwnd because a window can host more
+   than one cross-process surface at a time (steam's store page has a separate
+   renderer surface from the client chrome, its library does not), so a single
+   global slot would only ever cover whichever context was released last. */
+static void release_swapchain_resources(CAContext *context, CAMetalLayer *layer,
+                                        CALayer *container, macdrv_metal_device dev)
+{
     OnMainThreadAsync(^{
         [context setLayer:nil];
         [context release];
@@ -4187,6 +4197,50 @@ - (void) dealloc
         [container release];
         if (dev) macdrv_release_metal_device(dev);
     });
+}
+
++ (void) deferTeardownForHwnd:(void *)owner
+                     context:(CAContext *)context
+                       layer:(CAMetalLayer *)layer
+                   container:(CALayer *)container
+                      device:(macdrv_metal_device)dev
+{
+    static NSMutableDictionary<NSNumber *, NSArray *> *held;
+    NSNumber *key = @((uintptr_t)owner);
+    NSArray *prev;
+
+    if (!held) held = [[NSMutableDictionary alloc] init];
+
+    if ((prev = [[held objectForKey:key] retain]))
+    {
+        [held removeObjectForKey:key];
+        release_swapchain_resources([prev objectAtIndex:0] == [NSNull null] ? nil : [prev objectAtIndex:0],
+                                    [prev objectAtIndex:1] == [NSNull null] ? nil : [prev objectAtIndex:1],
+                                    [prev objectAtIndex:2] == [NSNull null] ? nil : [prev objectAtIndex:2],
+                                    (macdrv_metal_device)[[prev objectAtIndex:3] pointerValue]);
+        [prev release];
+    }
+
+    if (!context && !layer && !container && !dev) return;
+
+    [held setObject:@[ context   ? (id)context   : (id)[NSNull null],
+                       layer     ? (id)layer     : (id)[NSNull null],
+                       container ? (id)container : (id)[NSNull null],
+                       [NSValue valueWithPointer:dev] ]
+             forKey:key];
+}
+
+- (void) dealloc
+{
+    /* the hosting side drops its CALayerHost as usual; only the publisher's
+       side of the pair is held back, so nothing dead is left in a layer tree */
+    if (context_id) macdrv_release_remote_layer(hwnd, context_id);
+
+    [CAContextSwapChain deferTeardownForHwnd:hwnd
+                                     context:remote_context
+                                       layer:offscreen_layer
+                                   container:container_layer
+                                      device:device];
 
     [super dealloc];
 }
