+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_WINE_MACSYNC_H
+#define __WINE_WINE_MACSYNC_H
+
+#ifdef __APPLE__
+
+#include <errno.h>
+#include <stdint.h>
+
+#include "wine/server_protocol.h"  /* enum inproc_sync_type */
+
+/* Linux backs the in-process sync objects with /dev/ntsync, which does the
+ * whole state machine in the kernel. macOS has no equivalent, so the state
+ * lives in a page of shared memory per object and threads block on it with
+ * __ulock_wait, the same primitive libpthread uses for process-shared mutexes.
+ *
+ * The server creates each page with shm_open(), unlinks the name immediately
+ * and hands the descriptor to the client through the existing get_inproc_sync_fd
+ * request, so nothing about the protocol changes.
+ *
+ * Both structures are ABI between wineserver and ntdll: only ever append. */
+
+#define MACSYNC_MAGIC       0x6d73796e  /* "msyn" */
+#define MACSYNC_PAGE_SIZE   4096
+
+struct macsync
+{
+    unsigned int magic;
+    unsigned int type;       /* enum inproc_sync_type */
+    unsigned int manual;     /* event: manual reset */
+    unsigned int max;        /* semaphore: maximum count */
+    unsigned int seq;        /* bumped on every state change; wait address for single waits */
+    unsigned int waiters;    /* threads blocked on seq */
+    unsigned int count;      /* event: 0 or 1; semaphore: count; mutex: recursion depth */
+    unsigned int owner;      /* mutex: owning thread id, 0 when free */
+    unsigned int abandoned;  /* mutex: the previous owner died holding it */
+};
+
+/* A thread waiting on several objects cannot block on all of their sequence
+ * counters at once, so it blocks on this one instead, which every state change
+ * bumps. Single-object waits use the object's own counter and so are never
+ * woken by traffic on unrelated objects. */
+struct macsync_global
+{
+    unsigned int magic;
+    unsigned int seq;
+    unsigned int waiters;
+};
+
+extern int __ulock_wait( uint32_t operation, void *addr, uint64_t value, uint32_t timeout_us );
+extern int __ulock_wake( uint32_t operation, void *addr, uint64_t wake_value );
+
+#define MACSYNC_UL_COMPARE_AND_WAIT_SHARED  3
+#define MACSYNC_ULF_WAKE_ALL                0x00000100
+
+/* __ulock_wait takes a 32-bit microsecond timeout, so anything longer than
+ * about 71 minutes has to be split across several calls. */
+#define MACSYNC_MAX_WAIT_US 0xfffffffeu
+
+static inline unsigned int macsync_load( const unsigned int *p )
+{
+    return __atomic_load_n( p, __ATOMIC_SEQ_CST );
+}
+
+static inline void macsync_store( unsigned int *p, unsigned int val )
+{
+    __atomic_store_n( p, val, __ATOMIC_SEQ_CST );
+}
+
+static inline unsigned int macsync_swap( unsigned int *p, unsigned int val )
+{
+    return __atomic_exchange_n( p, val, __ATOMIC_SEQ_CST );
+}
+
+static inline int macsync_cas( unsigned int *p, unsigned int *expect, unsigned int val )
+{
+    return __atomic_compare_exchange_n( p, expect, val, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST );
+}
+
+static inline void macsync_wake_addr( unsigned int *addr )
+{
+    while (__ulock_wake( MACSYNC_UL_COMPARE_AND_WAIT_SHARED | MACSYNC_ULF_WAKE_ALL, addr, 0 ) < 0)
+        if (errno != EINTR) break;
+}
+
+/* Block until the counter moves off val, or the (absolute, mach) deadline passes.
+ * Returns 0 if it may have moved, -1 on timeout. */
+static inline int macsync_wait_addr( unsigned int *addr, unsigned int val, unsigned int timeout_us )
+{
+    int ret = __ulock_wait( MACSYNC_UL_COMPARE_AND_WAIT_SHARED, addr, val, timeout_us );
+
+    if (ret >= 0) return 0;
+    if (errno == ETIMEDOUT) return -1;
+    return 0;  /* EINTR, EFAULT and a value mismatch all just mean "look again" */
+}
+
+/* Announce a state change. The sequence counters are bumped unconditionally so
+ * that a thread about to block sees a different value and retries; the kernel is
+ * only entered when somebody is genuinely blocked. Bumping before reading the
+ * waiter count is what makes that safe: a waiter publishes itself before
+ * sampling the counter, so at least one of the two sees the other. */
+static inline void macsync_changed( struct macsync *sync, struct macsync_global *global )
+{
+    __atomic_fetch_add( &sync->seq, 1, __ATOMIC_SEQ_CST );
+    if (macsync_load( &sync->waiters )) macsync_wake_addr( &sync->seq );
+
+    if (!global) return;
+    __atomic_fetch_add( &global->seq, 1, __ATOMIC_SEQ_CST );
+    if (macsync_load( &global->waiters )) macsync_wake_addr( &global->seq );
+}
+
+/* state changes, all of them shared between the server and ntdll */
+
+static inline unsigned int macsync_set_event( struct macsync *sync )
+{
+    return macsync_swap( &sync->count, 1 );
+}
+
+static inline unsigned int macsync_reset_event( struct macsync *sync )
+{
+    return macsync_swap( &sync->count, 0 );
+}
+
+/* Returns 0, or -1 if the count would run past the maximum. */
+static inline int macsync_release_semaphore( struct macsync *sync, unsigned int add, unsigned int *prev )
+{
+    unsigned int old = macsync_load( &sync->count );
+
+    do
+    {
+        if (add > sync->max - old) return -1;
+    } while (!macsync_cas( &sync->count, &old, old + add ));
+
+    *prev = old;
+    return 0;
+}
+
+/* Returns 0, -1 if the caller does not own it, -2 if it is not held at all. */
+static inline int macsync_release_mutex( struct macsync *sync, unsigned int tid, unsigned int *prev )
+{
+    unsigned int count;
+
+    if (macsync_load( &sync->owner ) != tid) return -1;
+    if (!(count = macsync_load( &sync->count ))) return -2;
+
+    *prev = count;
+    if (count > 1) macsync_store( &sync->count, count - 1 );
+    else
+    {
+        /* clear the count first: the owner field is what an acquirer races on,
+         * so it has to be the last thing to go */
+        macsync_store( &sync->count, 0 );
+        macsync_store( &sync->owner, 0 );
+    }
+    return 0;
+}
+
+/* Would a wait on this object succeed right now, without consuming anything? */
+static inline int macsync_is_signaled( const struct macsync *sync, unsigned int tid )
+{
+    unsigned int owner;
+
+    switch (sync->type)
+    {
+    case INPROC_SYNC_INTERNAL:
+    case INPROC_SYNC_EVENT:
+    case INPROC_SYNC_SEMAPHORE:
+        return macsync_load( &sync->count ) != 0;
+    case INPROC_SYNC_MUTEX:
+        owner = macsync_load( &sync->owner );
+        return !owner || owner == tid;
+    }
+    return 0;
+}
+
+/* Consume one unit. Returns 1 on success, 0 if the object was not signaled.
+ * Sets *abandoned when the mutex had been left behind by a thread that died. */
+static inline int macsync_try_acquire( struct macsync *sync, unsigned int tid, int *abandoned )
+{
+    unsigned int old;
+
+    *abandoned = 0;
+
+    switch (sync->type)
+    {
+    case INPROC_SYNC_INTERNAL:
+    case INPROC_SYNC_EVENT:
+        if (sync->manual) return macsync_load( &sync->count ) != 0;
+        old = 1;
+        return macsync_cas( &sync->count, &old, 0 );
+
+    case INPROC_SYNC_SEMAPHORE:
+        old = macsync_load( &sync->count );
+        do
+        {
+            if (!old) return 0;
+        } while (!macsync_cas( &sync->count, &old, old - 1 ));
+        return 1;
+
+    case INPROC_SYNC_MUTEX:
+        if (macsync_load( &sync->owner ) == tid)
+        {
+            __atomic_fetch_add( &sync->count, 1, __ATOMIC_SEQ_CST );
+            return 1;
+        }
+        old = 0;
+        if (!macsync_cas( &sync->owner, &old, tid )) return 0;
+        macsync_store( &sync->count, 1 );
+        if (macsync_swap( &sync->abandoned, 0 )) *abandoned = 1;
+        return 1;
+    }
+    return 0;
+}
+
+/* Give back what macsync_try_acquire() took. A wait on several objects has to
+ * grab them one at a time, so a grab that turns out to be incomplete is undone
+ * and retried. */
+static inline void macsync_undo_acquire( struct macsync *sync, unsigned int tid, int abandoned )
+{
+    unsigned int prev;
+
+    switch (sync->type)
+    {
+    case INPROC_SYNC_INTERNAL:
+    case INPROC_SYNC_EVENT:
+        if (!sync->manual) macsync_store( &sync->count, 1 );
+        break;
+    case INPROC_SYNC_SEMAPHORE:
+        __atomic_fetch_add( &sync->count, 1, __ATOMIC_SEQ_CST );
+        break;
+    case INPROC_SYNC_MUTEX:
+        if (abandoned) macsync_store( &sync->abandoned, 1 );
+        macsync_release_mutex( sync, tid, &prev );
+        break;
+    }
+}
+
+#endif /* __APPLE__ */
+
+#endif /* __WINE_WINE_MACSYNC_H */
diff --git i/server/inproc_sync.c w/server/inproc_sync.c
index a291d10aa2..117af0e14a 100644
--- i/server/inproc_sync.c
+++ w/server/inproc_sync.c
@@ -240,6 +240,242 @@ static int get_obj_inproc_sync( struct object *obj, int *type )
     return fd;
 }
 
+#elif defined(__APPLE__)
+
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "wine/macsync.h"
+
+/* macOS has no /dev/ntsync, so each object gets a page of shared memory instead
+ * and threads block on it with __ulock_wait. The descriptor travels to the
+ * client through the same get_inproc_sync_fd request the Linux backend uses, so
+ * the protocol is unchanged.
+ *
+ * Opt in with WINEMSYNC=1: without it every object stays a plain server object
+ * and none of this runs. */
+
+static struct macsync_global *inproc_global;
+
+/* Create one page of shared memory and return a descriptor for it. The name only
+ * has to survive until the unlink, and PSHMNAMLEN is 31. */
+static int create_shared_page( void **map )
+{
+    static unsigned int counter;
+    char name[32];
+    void *ptr;
+    int fd;
+
+    for (;;)
+    {
+        snprintf( name, sizeof(name), "/wine-msync.%x.%x", (unsigned int)getpid(), counter++ );
+        if ((fd = shm_open( name, O_CREAT | O_EXCL | O_RDWR, 0600 )) >= 0) break;
+        if (errno != EEXIST) return -1;
+    }
+    shm_unlink( name );
+
+    if (ftruncate( fd, MACSYNC_PAGE_SIZE ) < 0) goto error;
+    if ((ptr = mmap( NULL, MACSYNC_PAGE_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 )) == MAP_FAILED)
+        goto error;
+
+    memset( ptr, 0, MACSYNC_PAGE_SIZE );
+    *map = ptr;
+    return fd;
+
+error:
+    close( fd );
+    return -1;
+}
+
+int get_inproc_device_fd(void)
+{
+    static int fd = -2;
+    const char *env;
+
+    if (fd != -2) return fd;
+
+    fd = -1;
+    if (!(env = getenv( "WINEMSYNC" )) || atoi( env ) <= 0) return fd;
+
+    if ((fd = create_shared_page( (void **)&inproc_global )) >= 0)
+    {
+        inproc_global->magic = MACSYNC_MAGIC;
+        if (debug_level) fprintf( stderr, "msync: up and running.\n" );
+    }
+    return fd;
+}
+
+struct inproc_sync
+{
+    struct object          obj;  /* object header */
+    enum inproc_sync_type  type;
+    int                    fd;
+    struct macsync        *shm;
+    struct list            entry;
+};
+
+static struct list inproc_mutexes = LIST_INIT( inproc_mutexes );
+
+static void inproc_sync_dump( struct object *obj, int verbose );
+static int inproc_sync_signal( struct object *obj, unsigned int access, int signal );
+static void inproc_sync_destroy( struct object *obj );
+
+static const struct object_ops inproc_sync_ops =
+{
+    sizeof(struct inproc_sync), /* size */
+    &no_type,                   /* type */
+    inproc_sync_dump,           /* dump */
+    no_add_queue,               /* add_queue */
+    NULL,                       /* remove_queue */
+    NULL,                       /* signaled */
+    NULL,                       /* satisfied */
+    inproc_sync_signal,         /* signal */
+    no_get_fd,                  /* get_fd */
+    default_get_sync,           /* get_sync */
+    default_map_access,         /* map_access */
+    default_get_sd,             /* get_sd */
+    default_set_sd,             /* set_sd */
+    default_get_full_name,      /* get_full_name */
+    no_lookup_name,             /* lookup_name */
+    directory_link_name,        /* link_name */
+    default_unlink_name,        /* unlink_name */
+    no_open_file,               /* open_file */
+    no_kernel_obj_list,         /* get_kernel_obj_list */
+    no_close_handle,            /* close_handle */
+    inproc_sync_destroy,        /* destroy */
+};
+
+int get_inproc_sync_fd( struct inproc_sync *sync )
+{
+    if (!sync) return -1;
+    return sync->fd;
+}
+
+static struct inproc_sync *create_inproc_sync( enum inproc_sync_type type, unsigned int manual,
+                                               unsigned int count, unsigned int max, unsigned int owner )
+{
+    struct inproc_sync *sync;
+
+    if (!(sync = alloc_object( &inproc_sync_ops ))) return NULL;
+    sync->type = type;
+    sync->shm  = NULL;
+    list_init( &sync->entry );
+
+    if ((sync->fd = create_shared_page( (void **)&sync->shm )) < 0)
+    {
+        set_error( STATUS_TOO_MANY_OPENED_FILES );
+        release_object( sync );
+        return NULL;
+    }
+
+    sync->shm->magic  = MACSYNC_MAGIC;
+    sync->shm->type   = type;
+    sync->shm->manual = manual;
+    sync->shm->max    = max;
+    sync->shm->count  = count;
+    sync->shm->owner  = owner;
+
+    if (type == INPROC_SYNC_MUTEX) list_add_tail( &inproc_mutexes, &sync->entry );
+    return sync;
+}
+
+struct inproc_sync *create_inproc_internal_sync( int manual, int signaled )
+{
+    return create_inproc_sync( INPROC_SYNC_INTERNAL, manual, !!signaled, 0, 0 );
+}
+
+struct inproc_sync *create_inproc_event_sync( int manual, int signaled )
+{
+    return create_inproc_sync( INPROC_SYNC_EVENT, manual, !!signaled, 0, 0 );
+}
+
+struct inproc_sync *create_inproc_mutex_sync( thread_id_t owner, unsigned int count )
+{
+    return create_inproc_sync( INPROC_SYNC_MUTEX, 0, count, 0, owner );
+}
+
+struct inproc_sync *create_inproc_semaphore_sync( unsigned int initial, unsigned int max )
+{
+    return create_inproc_sync( INPROC_SYNC_SEMAPHORE, 0, initial, max, 0 );
+}
+
+static void inproc_sync_dump( struct object *obj, int verbose )
+{
+    struct inproc_sync *sync = (struct inproc_sync *)obj;
+    assert( obj->ops == &inproc_sync_ops );
+    fprintf( stderr, "Inproc sync type=%d, fd=%d, count=%u, owner=%u\n",
+             sync->type, sync->fd, sync->shm->count, sync->shm->owner );
+}
+
+void signal_inproc_sync( struct inproc_sync *sync )
+{
+    if (debug_level) fprintf( stderr, "set_inproc_event %d\n", sync->fd );
+    macsync_set_event( sync->shm );
+    macsync_changed( sync->shm, inproc_global );
+}
+
+void reset_inproc_sync( struct inproc_sync *sync )
+{
+    if (debug_level) fprintf( stderr, "reset_inproc_event %d\n", sync->fd );
+    macsync_reset_event( sync->shm );
+}
+
+static int inproc_sync_signal( struct object *obj, unsigned int access, int signal )
+{
+    struct inproc_sync *sync = (struct inproc_sync *)obj;
+    assert( obj->ops == &inproc_sync_ops );
+
+    assert( sync->type == INPROC_SYNC_INTERNAL || sync->type == INPROC_SYNC_EVENT );
+    assert( signal == 0 || signal == 1 );
+
+    if (signal) signal_inproc_sync( sync );
+    else reset_inproc_sync( sync );
+    return 1;
+}
+
+static void inproc_sync_destroy( struct object *obj )
+{
+    struct inproc_sync *sync = (struct inproc_sync *)obj;
+    assert( obj->ops == &inproc_sync_ops );
+    list_remove( &sync->entry );
+    if (sync->shm) munmap( sync->shm, MACSYNC_PAGE_SIZE );
+    if (sync->fd >= 0) close( sync->fd );
+}
+
+void abandon_inproc_mutexes( thread_id_t tid )
+{
+    struct inproc_sync *mutex;
+
+    LIST_FOR_EACH_ENTRY( mutex, &inproc_mutexes, struct inproc_sync, entry )
+    {
+        if (macsync_load( &mutex->shm->owner ) != tid) continue;
+        macsync_store( &mutex->shm->count, 0 );
+        macsync_store( &mutex->shm->abandoned, 1 );
+        macsync_store( &mutex->shm->owner, 0 );
+        macsync_changed( mutex->shm, inproc_global );
+    }
+}
+
+static int get_obj_inproc_sync( struct object *obj, int *type )
+{
+    struct object *sync;
+    int fd = -1;
+
+    if (!(sync = get_obj_sync( obj ))) return -1;
+    if (sync->ops == &inproc_sync_ops)
+    {
+        struct inproc_sync *inproc = (struct inproc_sync *)sync;
+        *type = inproc->type;
+        fd = inproc->fd;
+    }
+
+    release_object( sync );
+    return fd;
+}
+
