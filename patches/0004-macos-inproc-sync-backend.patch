+#include "wine/macsync.h"
+
+/* macOS backend. The server keeps each object's state in a page of shared
+ * memory and hands us a descriptor for it; we map that page and run the state
+ * machine here, blocking on __ulock_wait when there is nothing to take.
+ *
+ * A thread cannot block on several addresses at once, so a wait on more than one
+ * object blocks on a single process-wide counter that every state change bumps,
+ * and rechecks the objects each time it wakes. A wait on one object blocks on
+ * that object's own counter and is never woken by unrelated traffic. */
+
+static struct macsync_global *mac_global;
+
+static void *mac_map_page( int fd )
+{
+    void *ptr = mmap( NULL, MACSYNC_PAGE_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 );
+
+    if (ptr == MAP_FAILED) return NULL;
+    /* Fault the page in. A shared __ulock_wait on a page that is mapped but not
+     * yet resident fails with EFAULT instead of blocking. */
+    (void)macsync_load( (unsigned int *)ptr );
+    return ptr;
+}
+
+static struct macsync_global *mac_get_global(void)
+{
+    struct macsync_global *ptr, *prev = NULL;
+
+    if ((ptr = __atomic_load_n( &mac_global, __ATOMIC_ACQUIRE ))) return ptr;
+    if (inproc_device_fd < 0) return NULL;
+    if (!(ptr = mac_map_page( inproc_device_fd ))) return NULL;
+
+    if (!__atomic_compare_exchange_n( &mac_global, &prev, ptr, 0,
+                                      __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE ))
+    {
+        munmap( ptr, MACSYNC_PAGE_SIZE );
+        return prev;
+    }
+    return ptr;
+}
+
+/* Map an object's page on first use. Several threads can reach this at once for
+ * the same cache entry, so a compare-and-swap picks the winner and the losers
+ * drop their mapping. */
+static struct macsync *mac_shm( struct inproc_sync *sync )
+{
+    void *ptr, *prev = NULL;
+
+    if ((ptr = __atomic_load_n( &sync->shm, __ATOMIC_ACQUIRE ))) return ptr;
+    if (!(ptr = mac_map_page( sync->fd ))) return NULL;
+
+    if (!__atomic_compare_exchange_n( &sync->shm, &prev, ptr, 0,
+                                      __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE ))
+    {
+        munmap( ptr, MACSYNC_PAGE_SIZE );
+        return prev;
+    }
+    return ptr;
+}
+
+static inline void mac_publish( unsigned int *waiters )
+{
+    __atomic_fetch_add( waiters, 1, __ATOMIC_SEQ_CST );
+}
+
+static inline void mac_unpublish( unsigned int *waiters )
+{
+    __atomic_fetch_sub( waiters, 1, __ATOMIC_SEQ_CST );
+}
+
+static NTSTATUS linux_release_semaphore_obj( struct inproc_sync *sync, ULONG count, ULONG *prev_count )
+{
+    struct macsync *shm = mac_shm( sync );
+    unsigned int prev;
+
+    if (!shm) return STATUS_NO_MEMORY;
+    if (macsync_release_semaphore( shm, count, &prev ) < 0) return STATUS_SEMAPHORE_LIMIT_EXCEEDED;
+    macsync_changed( shm, mac_get_global() );
+    if (prev_count) *prev_count = prev;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_query_semaphore_obj( struct inproc_sync *sync, SEMAPHORE_BASIC_INFORMATION *info )
+{
+    struct macsync *shm = mac_shm( sync );
+
+    if (!shm) return STATUS_NO_MEMORY;
+    info->CurrentCount = macsync_load( &shm->count );
+    info->MaximumCount = shm->max;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_set_event_obj( struct inproc_sync *sync, LONG *prev_state )
+{
+    struct macsync *shm = mac_shm( sync );
+    unsigned int prev;
+
+    if (!shm) return STATUS_NO_MEMORY;
+    prev = macsync_set_event( shm );
+    macsync_changed( shm, mac_get_global() );
+    if (prev_state) *prev_state = prev;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_reset_event_obj( struct inproc_sync *sync, LONG *prev_state )
+{
+    struct macsync *shm = mac_shm( sync );
+    unsigned int prev;
+
+    if (!shm) return STATUS_NO_MEMORY;
+    /* nothing becomes available, so nobody needs waking */
+    prev = macsync_reset_event( shm );
+    if (prev_state) *prev_state = prev;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_pulse_event_obj( struct inproc_sync *sync, LONG *prev_state )
+{
+    struct macsync *shm = mac_shm( sync );
+    unsigned int prev;
+
+    if (!shm) return STATUS_NO_MEMORY;
+    /* Release whoever is waiting right now and drop straight back to unsignaled.
+     * Windows documents PulseEvent as unreliable for exactly this reason. */
+    prev = macsync_set_event( shm );
+    macsync_changed( shm, mac_get_global() );
+    macsync_reset_event( shm );
+    if (prev_state) *prev_state = prev;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_query_event_obj( struct inproc_sync *sync, EVENT_BASIC_INFORMATION *info )
+{
+    struct macsync *shm = mac_shm( sync );
+
+    if (!shm) return STATUS_NO_MEMORY;
+    info->EventType = shm->manual ? NotificationEvent : SynchronizationEvent;
+    info->EventState = macsync_load( &shm->count );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_release_mutex_obj( struct inproc_sync *sync, LONG *prev_count )
+{
+    struct macsync *shm = mac_shm( sync );
+    unsigned int prev;
+
+    if (!shm) return STATUS_NO_MEMORY;
+    if (macsync_release_mutex( shm, GetCurrentThreadId(), &prev ) < 0) return STATUS_MUTANT_NOT_OWNED;
+    macsync_changed( shm, mac_get_global() );
+    /* the mutant count runs the other way from the recursion depth: 1 once the
+     * mutex is free, 0 or less while it is still held */
+    if (prev_count) *prev_count = 2 - (LONG)prev;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_query_mutex_obj( struct inproc_sync *sync, MUTANT_BASIC_INFORMATION *info )
+{
+    struct macsync *shm = mac_shm( sync );
+
+    if (!shm) return STATUS_NO_MEMORY;
+    info->AbandonedState = macsync_load( &shm->abandoned ) ? TRUE : FALSE;
+    info->OwnedByCaller = (macsync_load( &shm->owner ) == GetCurrentThreadId());
+    info->CurrentCount = 1 - (LONG)macsync_load( &shm->count );
+    return STATUS_SUCCESS;
+}
+
+/* The alert object arrives as a bare descriptor rather than a cached sync, and
+ * it belongs to the calling thread, so its mapping lives with the thread. */
+static struct macsync *mac_alert_sync( int alert_fd )
+{
+    static __thread struct macsync *mapped;
+    static __thread int mapped_fd = -1;
+
+    if (alert_fd <= 0) return NULL;
+    if (alert_fd != mapped_fd)
+    {
+        void *ptr;
+
+        if (!(ptr = mac_map_page( alert_fd ))) return NULL;
+        if (mapped) munmap( mapped, MACSYNC_PAGE_SIZE );
+        mapped = ptr;
+        mapped_fd = alert_fd;
+    }
+    return mapped;
+}
+
+/* Absolute deadline in nanoseconds, on the monotonic clock for a relative
+ * timeout and the realtime clock for an absolute one, matching the two forms the
+ * Linux backend hands to the kernel. */
+struct mac_deadline
+{
+    ULONGLONG when;
+    int       infinite;
+    int       realtime;
+};
+
+static void mac_deadline_init( struct mac_deadline *d, const LARGE_INTEGER *timeout )
+{
+    struct timespec now;
+
+    if (!timeout || timeout->QuadPart == TIMEOUT_INFINITE)
+    {
+        d->infinite = 1;
+        d->realtime = 0;
+        d->when = 0;
+        return;
+    }
+
+    d->infinite = 0;
+    if (timeout->QuadPart <= 0)
+    {
+        d->realtime = 0;
+        clock_gettime( CLOCK_MONOTONIC, &now );
+        d->when = (ULONGLONG)now.tv_sec * NSECPERSEC + now.tv_nsec + (-timeout->QuadPart * 100);
+    }
+    else
+    {
+        d->realtime = 1;
+        d->when = (timeout->QuadPart * 100) - (SECS_1601_TO_1970 * NSECPERSEC);
+    }
+}
+
+/* Microseconds left, or 0 once the deadline has passed. */
+static unsigned int mac_deadline_remaining( const struct mac_deadline *d )
+{
+    struct timespec now;
+    ULONGLONG ns;
+
+    if (d->infinite) return MACSYNC_MAX_WAIT_US;
+
+    clock_gettime( d->realtime ? CLOCK_REALTIME : CLOCK_MONOTONIC, &now );
+    ns = (ULONGLONG)now.tv_sec * NSECPERSEC + now.tv_nsec;
+    if (ns >= d->when) return 0;
+
+    ns = (d->when - ns) / 1000;
+    if (ns > MACSYNC_MAX_WAIT_US) return MACSYNC_MAX_WAIT_US;
+    return ns ? (unsigned int)ns : 1;
+}
+
+/* The alert fired: let the server deliver the APC, exactly as the Linux path does. */
+static NTSTATUS mac_deliver_apc(void)
+{
+    static const LARGE_INTEGER zero;
+    NTSTATUS ret = server_wait( NULL, 0, SELECT_INTERRUPTIBLE | SELECT_ALERTABLE, &zero );
+
+    assert( ret == STATUS_USER_APC );
+    return ret;
+}
+
+static NTSTATUS linux_wait_objs( int device, DWORD count, struct inproc_sync **syncs, WAIT_TYPE type,
+                                 int alert_fd, const LARGE_INTEGER *timeout )
+{
+    struct macsync *shms[64], *alert;
+    struct macsync_global *global;
+    unsigned int tid = GetCurrentThreadId();
+    int abandoned[64];
+    struct mac_deadline deadline;
+    unsigned int *addr, *waiters;
+    DWORD i;
+
+    (void)device;  /* the shared pages carry everything; there is no device here */
+
+    if (count > ARRAY_SIZE(shms)) return STATUS_INVALID_PARAMETER;
+    for (i = 0; i < count; i++)
+        if (!(shms[i] = mac_shm( syncs[i] ))) return STATUS_NO_MEMORY;
+
+    alert = mac_alert_sync( alert_fd );
+    global = mac_get_global();
+    mac_deadline_init( &deadline, timeout );
+
+    /* One object and no alert can block on that object alone; anything else
+     * falls back to the shared counter. */
+    if (count == 1 && !alert)
+    {
+        addr = &shms[0]->seq;
+        waiters = &shms[0]->waiters;
+    }
+    else
+    {
+        if (!global) return STATUS_NOT_IMPLEMENTED;
+        addr = &global->seq;
+        waiters = &global->waiters;
+    }
+
+    for (;;)
+    {
+        unsigned int seq, timeout_us;
+        int ab = 0;
+
+        /* Publish before sampling the counter. A signaller bumps the counter
+         * before it reads the waiter count, so one of the two always sees the
+         * other and a wakeup cannot go missing. */
+        mac_publish( waiters );
+        seq = macsync_load( addr );
+
+        if (type != WaitAll)
+        {
+            for (i = 0; i < count; i++)
+            {
+                if (!macsync_try_acquire( shms[i], tid, &ab )) continue;
+                mac_unpublish( waiters );
+                return (ab ? STATUS_ABANDONED : STATUS_WAIT_0) + i;
+            }
+        }
+        else
+        {
+            /* Look before taking, so that one object not being ready does not
+             * disturb the others. */
+            for (i = 0; i < count; i++)
+                if (!macsync_is_signaled( shms[i], tid )) break;
+
+            if (i == count)
+            {
+                for (i = 0; i < count; i++)
+                    if (!macsync_try_acquire( shms[i], tid, &abandoned[i] )) break;
+
+                if (i == count)
+                {
+                    mac_unpublish( waiters );
+                    for (i = 0; i < count; i++) if (abandoned[i]) return STATUS_ABANDONED;
+                    return STATUS_WAIT_0;
+                }
+
+                /* Somebody raced us to one of them. Put back what we took and
+                 * start over rather than hold a partial set. */
+                while (i--) macsync_undo_acquire( shms[i], tid, abandoned[i] );
+                macsync_changed( shms[0], global );
+                mac_unpublish( waiters );
+                continue;
+            }
+        }
+
+        if (alert && macsync_try_acquire( alert, tid, &ab ))
+        {
+            mac_unpublish( waiters );
+            return mac_deliver_apc();
+        }
+
+        if (!(timeout_us = mac_deadline_remaining( &deadline )))
+        {
+            mac_unpublish( waiters );
+            return STATUS_TIMEOUT;
+        }
+
+        macsync_wait_addr( addr, seq, timeout_us );
+        mac_unpublish( waiters );
+    }
+}
